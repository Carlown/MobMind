{
  "schemaVersion": 1,
  "id": "mobmind",
  "version": "${version}",
  "name": "MobMind - 生物心智",
  "description": "为 Minecraft 生物赋予独立 AI 人格：语音对话、好感度、行为影响。",
  "authors": ["MobMind"],
  "license": "MIT",
  "icon": "assets/mobmind/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mobmind.MobMindMod"],
    "client": ["com.mobmind.client.MobMindClient"]
  },
  "mixins": ["mobmind.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
